[cisco_ios]
leaf01 ansible_host=192.168.1.10
leaf02 ansible_host=192.168.1.11

[dell_emc]
leaf03 ansible_host=192.168.1.12
leaf04 ansible_host=192.168.1.13

# Variables applied to all hosts in the cisco_ios group
[cisco_ios:vars]
ansible_connection=ansible.netcommon.network_cli
ansible_network_os=cisco.ios.ios
ansible_user=admin
ansible_become=yes
ansible_become_method=enable
ansible_ssh_common_args='-o PreferredAuthentications=password,keyboard-interactive -o PubkeyAuthentication=no'
ansible_network_cli_ssh_type=paramiko
ansible_paramiko_look_for_keys=false

[dell_emc:vars]
ansible_connection=ansible.netcommon.network_cli
ansible_network_os=os10
ansible_user=ec2-user
ansible_become=yes
ansible_become_method=enable

# Parent group that includes multiple child groups
[all_switches:children]
cisco_ios
dell_emc
